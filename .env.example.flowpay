# QeSuite FlowPay
# Copy relevant keys into the repository's normal environment setup.
# Never commit real credentials.

# Explicit local/demo provider. Omit FLOWPAY_PROVIDER to leave READY work
# durably pending until a reviewed provider adapter is configured.
# FLOWPAY_PROVIDER=simulation
# FLOWPAY_SIMULATION_BEHAVIOR=CONFIRMED

# Cloudflare Access is required before /api/v1 routes are exposed.
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-access-application-audience-tag

# Circle Developer-Controlled Wallets on Arc Testnet. Select explicitly with:
# FLOWPAY_PROVIDER=circle-wallets
# Store API key and entity secret with `wrangler secret put`; never commit them.
# CIRCLE_API_KEY=secret
# CIRCLE_ENTITY_SECRET=32-byte-entity-secret
# The Arc Testnet USDC token UUID returned by Circle (not its contract address).
# CIRCLE_USDC_TOKEN_ID=00000000-0000-4000-8000-000000000000
# Optional only for an approved Circle-compatible endpoint in tests.
# CIRCLE_API_BASE_URL=https://api.circle.com
